# Auto detect text files and perform LF normalization
* text=auto

# Legal texts: byte-exact (a test pins LICENSE's hash), never converted to CRLF
LICENSE text eol=lf
NOTICE text eol=lf

# Python files
*.py text diff=python

# Markdown and docs
*.md text
*.rst text

# Config / data
*.json text
*.toml text
*.txt text
*.yaml text
*.yml text

# Executables / binaries (do not normalize line endings)
*.exe -text
*.dll -text
*.so -text
*.bin -text
